generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model DemoRequest {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  company   String
  role      String?
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("demo_requests")
}


model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_messages")
}