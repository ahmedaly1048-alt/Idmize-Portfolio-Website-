model CookieConsent {
  id        String   @id @default(cuid())
  // Client identifier (IP + User Agent hash for privacy)
  clientId  String
  // Cookie preferences JSON
  essential Boolean  @default(true)
  analytics Boolean  @default(false)
  marketing Boolean  @default(false)
  // IP address (anonymized last octet)
  ipAddress String?
  // User agent
  userAgent String?
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // TTL - expires after 1 year of no update
  expiresAt DateTime

  @@index([clientId])
  @@index([createdAt])
  @@map("cookie_consents")
}

model CookieConsentHistory {
  id        String   @id @default(cuid())
  clientId  String
  // What changed
  essential Boolean?
  analytics Boolean?
  marketing Boolean?
  // Action taken
  action    String   // 'accepted', 'rejected', 'updated', 'withdrawn'
  // IP and user agent
  ipAddress String?
  userAgent String?
  // Timestamps
  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([createdAt])
  @@map("cookie_consent_history")
}

model PrivacyPolicyVersion {
  id        String   @id @default(cuid())
  version   String   @unique // e.g., "1.0", "1.1"
  content   String   @db.Text
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([version])
  @@map("privacy_policy_versions")
}
